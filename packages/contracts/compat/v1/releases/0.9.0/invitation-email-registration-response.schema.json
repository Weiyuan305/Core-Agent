{
  "$id": "core-agent://v1/invitation-email-registration-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1,
      "title": "SchemaVersion",
      "type": "number"
    },
    "status": {
      "const": "verification_pending",
      "type": "string"
    },
    "verification_id": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "status"
  ],
  "type": "object"
}
