{
  "$id": "core-agent://v1/invitation-inspect-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "invitation_secret": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "SchemaVersion",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "invitation_secret"
  ],
  "type": "object"
}
