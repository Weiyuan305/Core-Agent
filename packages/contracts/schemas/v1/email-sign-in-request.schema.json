{
  "$id": "core-agent://v1/email-sign-in-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_kind": {
      "anyOf": [
        {
          "const": "web",
          "type": "string"
        },
        {
          "const": "iphone",
          "type": "string"
        },
        {
          "const": "macos",
          "type": "string"
        }
      ]
    },
    "device_label": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    },
    "email": {
      "format": "email",
      "maxLength": 320,
      "minLength": 3,
      "type": "string"
    },
    "password": {
      "maxLength": 1024,
      "minLength": 8,
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "SchemaVersion",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "email",
    "password",
    "client_kind"
  ],
  "type": "object"
}
