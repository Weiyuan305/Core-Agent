{
  "$id": "core-agent://v1/company-membership-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "idempotency_key": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "invitation_ref": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "payload_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "role": {
      "anyOf": [
        {
          "const": "admin",
          "type": "string"
        },
        {
          "const": "consultant",
          "type": "string"
        }
      ]
    },
    "schema_version": {
      "const": 1,
      "title": "SchemaVersion",
      "type": "number"
    },
    "tenant_id": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "idempotency_key",
    "payload_hash",
    "tenant_id",
    "role",
    "invitation_ref"
  ],
  "type": "object"
}
