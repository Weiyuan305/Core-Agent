{
  "$id": "core-agent://v1/reauthentication-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "client_kind": {
      "anyOf": [
        {
          "const": "web",
          "type": "string"
        },
        {
          "const": "iphone",
          "type": "string"
        },
        {
          "const": "macos",
          "type": "string"
        }
      ]
    },
    "expected_resource_version": {
      "minimum": 1,
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "password": {
      "maxLength": 1024,
      "minLength": 8,
      "type": "string"
    },
    "payload_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "SchemaVersion",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "idempotency_key",
    "payload_hash",
    "expected_resource_version",
    "password"
  ],
  "type": "object"
}
