{
  "$id": "core-agent://v1/company-create-response",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "administrator_invitation_id": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "administrator_invitation_resource_version": {
      "minimum": 1,
      "type": "integer"
    },
    "administrator_invitation_secret": {
      "pattern": "^[A-Za-z0-9_-]{43}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "SchemaVersion",
      "type": "number"
    },
    "tenant_id": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "tenant_resource_version": {
      "minimum": 1,
      "type": "integer"
    }
  },
  "required": [
    "schema_version",
    "tenant_id",
    "tenant_resource_version",
    "administrator_invitation_id",
    "administrator_invitation_resource_version",
    "administrator_invitation_secret"
  ],
  "type": "object"
}
