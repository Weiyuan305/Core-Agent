# Copy this file only as a path/reference template. Never put key bytes here.
# Set ARCHITECTURE to amd64 or arm64 for the host running Docker.
CORE_AGENT_PLATFORM=linux/${ARCHITECTURE}

# Generate both immutable references with: npm run runtime:images
CORE_AGENT_NODE_IMAGE=node:22-bookworm-slim@sha256:<resolve-with-npm-run-runtime-images>
CORE_AGENT_POSTGRES_IMAGE=postgres:17-bookworm@sha256:<resolve-with-npm-run-runtime-images>

# Reviewed immutable Core-Agent product image lock. The official Hermes base
# lock is not a valid substitute because it lacks the fixed product entrypoints.
CORE_AGENT_HERMES_IMAGE_LOCK_FILE=/absolute/path/to/Core-Agent/infra/hermes/product-images.lock.json

# These point to caller-created local projections. Secret values stay in files.
CORE_AGENT_BOOTSTRAP_KEY_FILE=/absolute/path/to/bootstrap-key
CORE_AGENT_POSTGRES_BOOTSTRAP_PASSWORD_FILE=/absolute/path/to/postgres-bootstrap-password
CORE_AGENT_DATABASE_MIGRATOR_PASSWORD_FILE=/absolute/path/to/database-migrator-password
CORE_AGENT_DATABASE_APP_PASSWORD_FILE=/absolute/path/to/database-app-password
CORE_AGENT_DATABASE_IDENTITY_PASSWORD_FILE=/absolute/path/to/database-identity-password
CORE_AGENT_PROVIDER_SECRET_ROOT=/absolute/path/to/provider-secret-directory
CORE_AGENT_INGRESS_SECRET_ROOT=/absolute/path/to/ingress-secret-directory
CORE_AGENT_SUPERVISOR_STATE_ROOT=/absolute/path/to/runtime-state-directory

# Daemon-side local Unix socket bind source. Select the exact platform value
# from docs/operations/runtime-v1-local-smoke.md; this is not necessarily the
# Docker CLI endpoint visible on the host. Ambient DOCKER_HOST is forbidden;
# select the documented local endpoint with `docker context use` instead.
CORE_AGENT_DOCKER_SOCKET_SOURCE=/absolute/daemon-side/docker.sock

# Before Compose, run `npm run runtime:paths`.
# The bootstrap source must be a regular file owned by the API runtime UID with mode 0600
# and have exactly one hard link.
# Provider and ingress must be existing 0700 directories; state must be absent or a
# 0700 directory. Preflight creates private `staging` and `ingress` children below the
# state root. The Supervisor UDS uses an isolated Docker named volume initialized by
# Compose, while the state path must remain shared with Docker Desktop/Colima on macOS
# (normally a canonical path below /Users).
# All roots use the Supervisor runtime UID/common socket GID.
# Every configured path and ancestor must be canonical and protected, and no
# projection may contain another. Preflight validates metadata without reading
# secret bytes.
#
# Development only: use the numeric host identity so bind-mounted files and
# roots remain accessible under Docker Desktop/Colima. Worker and Supervisor
# intentionally share this development UID. Production keeps dedicated
# service identities and uses ownership-aware orchestrator projections.
CORE_AGENT_RUNTIME_UID=<numeric-output-of-id-u>
CORE_AGENT_RUNTIME_GID=<numeric-output-of-id-g>
CORE_AGENT_SUPERVISOR_SOCKET_GID=<numeric-output-of-id-g>

# Numeric group owning the daemon-side socket selected above. Derive it with the
# platform-specific procedure and let the fixed Supervisor-image preflight prove
# the final identity can perform the bounded Docker _ping.
CORE_AGENT_DOCKER_GID=<numeric-docker-socket-group>
