{
  "$id": "core-agent://v1/invitation-acceptance-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authentication_proof": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "client_kind": {
              "anyOf": [
                {
                  "const": "web",
                  "type": "string"
                },
                {
                  "const": "iphone",
                  "type": "string"
                },
                {
                  "const": "macos",
                  "type": "string"
                }
              ]
            },
            "email": {
              "format": "email",
              "maxLength": 320,
              "minLength": 3,
              "type": "string"
            },
            "kind": {
              "const": "email_password",
              "type": "string"
            },
            "password": {
              "maxLength": 1024,
              "minLength": 8,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "client_kind",
            "email",
            "password"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorization_code": {
              "maxLength": 4096,
              "minLength": 8,
              "type": "string"
            },
            "client_kind": {
              "const": "web",
              "type": "string"
            },
            "kind": {
              "const": "apple",
              "type": "string"
            },
            "state": {
              "maxLength": 4096,
              "minLength": 8,
              "type": "string"
            },
            "transaction_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "client_kind",
            "transaction_id",
            "authorization_code",
            "state"
          ],
          "type": "object"
        },
        {
          "additionalProperties": false,
          "properties": {
            "authorization_code": {
              "maxLength": 4096,
              "minLength": 8,
              "type": "string"
            },
            "client_kind": {
              "anyOf": [
                {
                  "const": "iphone",
                  "type": "string"
                },
                {
                  "const": "macos",
                  "type": "string"
                }
              ]
            },
            "kind": {
              "const": "apple",
              "type": "string"
            },
            "nonce": {
              "maxLength": 4096,
              "minLength": 8,
              "type": "string"
            },
            "pkce_code_verifier": {
              "maxLength": 128,
              "minLength": 43,
              "pattern": "^[A-Za-z0-9._~-]+$",
              "type": "string"
            },
            "state": {
              "maxLength": 4096,
              "minLength": 8,
              "type": "string"
            },
            "transaction_id": {
              "maxLength": 255,
              "minLength": 1,
              "type": "string"
            }
          },
          "required": [
            "kind",
            "client_kind",
            "transaction_id",
            "authorization_code",
            "state",
            "nonce",
            "pkce_code_verifier"
          ],
          "type": "object"
        }
      ]
    },
    "device_label": {
      "maxLength": 80,
      "minLength": 1,
      "type": "string"
    },
    "expected_resource_version": {
      "minimum": 1,
      "type": "integer"
    },
    "idempotency_key": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "invitation_secret": {
      "maxLength": 1024,
      "minLength": 16,
      "type": "string"
    },
    "payload_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "SchemaVersion",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "idempotency_key",
    "payload_hash",
    "expected_resource_version",
    "invitation_secret",
    "authentication_proof"
  ],
  "type": "object"
}
