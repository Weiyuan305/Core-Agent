{
  "$id": "core-agent://v1/apple-identity-link-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "additionalProperties": false,
      "properties": {
        "authorization_code": {
          "maxLength": 4096,
          "minLength": 8,
          "type": "string"
        },
        "client_kind": {
          "const": "web",
          "type": "string"
        },
        "expected_resource_version": {
          "minimum": 1,
          "type": "integer"
        },
        "idempotency_key": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "SchemaVersion",
          "type": "number"
        },
        "state": {
          "maxLength": 4096,
          "minLength": 8,
          "type": "string"
        },
        "transaction_id": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "idempotency_key",
        "payload_hash",
        "expected_resource_version",
        "client_kind",
        "transaction_id",
        "authorization_code",
        "state"
      ],
      "type": "object"
    },
    {
      "additionalProperties": false,
      "properties": {
        "authorization_code": {
          "maxLength": 4096,
          "minLength": 8,
          "type": "string"
        },
        "client_kind": {
          "anyOf": [
            {
              "const": "iphone",
              "type": "string"
            },
            {
              "const": "macos",
              "type": "string"
            }
          ]
        },
        "expected_resource_version": {
          "minimum": 1,
          "type": "integer"
        },
        "idempotency_key": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        },
        "nonce": {
          "maxLength": 4096,
          "minLength": 8,
          "type": "string"
        },
        "payload_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "pkce_code_verifier": {
          "maxLength": 128,
          "minLength": 43,
          "pattern": "^[A-Za-z0-9._~-]+$",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "SchemaVersion",
          "type": "number"
        },
        "state": {
          "maxLength": 4096,
          "minLength": 8,
          "type": "string"
        },
        "transaction_id": {
          "maxLength": 255,
          "minLength": 1,
          "type": "string"
        }
      },
      "required": [
        "schema_version",
        "idempotency_key",
        "payload_hash",
        "expected_resource_version",
        "client_kind",
        "transaction_id",
        "authorization_code",
        "state",
        "nonce",
        "pkce_code_verifier"
      ],
      "type": "object"
    }
  ]
}
