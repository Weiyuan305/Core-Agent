{
  "$id": "core-agent://v1/reauthentication-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "password": {
      "maxLength": 1024,
      "minLength": 8,
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "SchemaVersion",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "password"
  ],
  "type": "object"
}
