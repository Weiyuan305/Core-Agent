{
  "$id": "core-agent://v1/password-reset-completion-request",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "authorization_code": {
      "maxLength": 4096,
      "minLength": 8,
      "type": "string"
    },
    "idempotency_key": {
      "maxLength": 255,
      "minLength": 1,
      "type": "string"
    },
    "new_password": {
      "maxLength": 1024,
      "minLength": 8,
      "type": "string"
    },
    "payload_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": 1,
      "title": "SchemaVersion",
      "type": "number"
    }
  },
  "required": [
    "schema_version",
    "idempotency_key",
    "payload_hash",
    "authorization_code",
    "new_password"
  ],
  "type": "object"
}
